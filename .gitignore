# Generated iTunes XML exports (default disk-export destination)
out/
output/

# Playwright
web/test-results/
web/playwright-report/
test-results/
playwright-report/
playwright-test.*.db
playwright-test.*.db-wal
playwright-test.*.db-shm
playwright-stations.*/

# Coverage output
.coverage
web/coverage/

# Database backups (DESIGN.md §14.18). User-data; never repo content.
backups/
.claude/

# §16.15 c1 — MkDocs build output. Source lives in docs/; the
# rendered HTML/CSS/JS lands in site/ and is published to GH Pages
# via the docs workflow, never committed to main.
site/
# §16.15 c4 — OpenAPI dump consumed by mkdocs-render-swagger-plugin.
# Regenerated by `make docs-openapi` (chained from docs-build +
# docs-serve); committing would risk drift between the JSON and
# the FastAPI app's actual schema.
docs/reference/openapi.json
# §16.15 c5 — CLI --help dump consumed by the docs build.
# Regenerated by `make docs-cli`; same drift logic as openapi.json.
docs/reference/cli.md
