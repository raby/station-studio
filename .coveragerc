# Coverage settings for the backend gate (`make test-backend`).
#
# `make test-backend` runs `coverage run -m pytest` then `coverage report
# --fail-under=90`. The 90% threshold is enforced by the report step;
# this file just narrows what counts as "source" — tests covering
# themselves is meaningless noise that previously inflated the total.

[run]
# Measure Python processes the tests start too (tests/test_docs_dumps.py,
# the CLI subprocess tests). Needs coverage 7.10+; their data files are
# combined into .coverage when the run ends.
patch = subprocess
source =
    engine
    api
    scripts
omit =
    # One-shot fixture generators (§14.37, §14.40) — committed to make
    # fixture provenance auditable, but the FIXTURES are what's under
    # test, not the generators. Running them from CI would only confirm
    # we can still write JSON.
    scripts/generate_byte_eq_fixtures.py
    scripts/generate_classics_fixtures.py
    # Dump-from-weekly helpers (§14.34 + §14.37) — designed to run
    # INSIDE a weekly checkout with weekly's venv. They import
    # weekly's `app.services.*` modules which aren't installed in
    # station-studio's venv. Covered indirectly via the fixtures they
    # produce + the smoke-test-against-real-weekly commands in DESIGN.
    scripts/dump_weekly_template.py
    scripts/dump_weekly_playlist.py
    # Runs as its own CI step (`make migration-parity` in ci.yml):
    # alembic upgrade head vs create_all, so a gap fails CI directly.
    scripts/check_migration_parity.py
    # Operator tool for listening checks: needs a folder of real
    # iTunes XML exports, which CI doesn't have.
    scripts/generate_user_playlists.py

[report]
# Don't bother flagging lines that obviously don't need coverage.
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
